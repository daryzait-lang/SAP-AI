# ==============================================================================
# SAP B1 Engineering Copilot - Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
# AVISO DE SEGURIDAD CRÍTICO:
# - Este archivo es únicamente un archivo de ejemplo / plantilla.
# - El archivo real (.env) JAMÁS debe entrar en Git, repositorios ni commits.
# - El archivo .env está explicitamente ignorado en .gitignore.
# - Mantenga las credenciales reales protegidas en su entorno local.
# ==============================================================================

# Entorno de la aplicación (DEV o PROD) - Por defecto siempre DEV
SAP_COPILOT_ENV=DEV

# Habilitación explícita de producción (false por defecto, nunca activar en desarrollo)
SAP_ALLOW_PRODUCTION=false

# ------------------------------------------------------------------------------
# SAP Business One Service Layer (Ambiente DEV)
# ------------------------------------------------------------------------------
SAP_SL_BASE_URL=
SAP_SL_COMPANY_DB=
SAP_SL_USERNAME=
SAP_SL_PASSWORD=

# ------------------------------------------------------------------------------
# SAP HANA DEV (Acceso estrictamente de SOLO LECTURA)
# ------------------------------------------------------------------------------
HANA_HOST=
HANA_PORT=
HANA_USER=
HANA_PASSWORD=

# ------------------------------------------------------------------------------
# Orquestación de IA / Proveedores de Modelos
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
